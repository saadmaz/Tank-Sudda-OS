rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors the identity helpers in firestore.rules (same token claims).
    function isAuth() { return request.auth != null && request.auth.token.role is string; }

    // Company logo used on documents. Read by any signed-in person.
    match /branding/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.token.role in ["Admin", "SuperAdmin"]
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Before and after photos on a job. Anyone working on jobs may add them.
    match /jobs/{jobId}/photos/{fileName} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && request.auth.token.role in ["Manager", "Admin", "SuperAdmin"];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
