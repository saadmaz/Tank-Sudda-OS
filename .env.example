# Copy this file to .env and fill in the values before running or deploying.

# ── Firebase client (embedded in the browser bundle, safe to expose) ──────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only, NEVER commit the real values) ────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Website intake (src/routes/api.public.website-lead.ts) ──────────────────
# Shared secret; set the same value as LEAD_WEBHOOK_SECRET on the website, with
# LEAD_WEBHOOK_URL=https://os.tanksudda.com/api/public/website-lead
WEBSITE_WEBHOOK_SECRET=

# ── Sentry error reporting (optional) ────────────────────────────────────────
VITE_SENTRY_DSN=

# ── First SuperAdmin (seeding only, `npm run seed:admin`) ────────────────────
# Remove the PIN from .env afterwards; the account must choose its own PIN at
# first sign-in, so this is a one-time bootstrap credential.
SUPERADMIN_NAME=
SUPERADMIN_USERNAME=
SUPERADMIN_PIN=

# ── Local emulators (optional) ───────────────────────────────────────────────
# VITE_USE_FIREBASE_EMULATOR=true

# ── Legacy import (scripts/export-legacy.ts, one-time) ───────────────────────
# Service account of the legacy app's Firebase project (read-only use).
LEGACY_PROJECT_ID=
LEGACY_CLIENT_EMAIL=
LEGACY_PRIVATE_KEY=
