rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ────────────────────────────────────────────────────────────
    // `role`, `perms` and `name` are claims minted into the custom token by
    // loginFn (src/server/auth.ts). Changing someone's access revokes their
    // refresh tokens, so a stale claim lasts at most one ID-token lifetime.
    function isAuth()           { return request.auth != null && request.auth.token.role is string; }
    function role()             { return request.auth.token.role; }
    function uid()              { return request.auth.uid; }

    function isSuperAdmin()     { return isAuth() && role() == "SuperAdmin"; }
    function isAdmin()          { return isAuth() && role() in ["Admin", "SuperAdmin"]; }
    function isManagerOrAbove() { return isAuth() && role() in ["Manager", "Admin", "SuperAdmin"]; }

    // Mirrors hasModule() in src/lib/permissions.ts.
    function hasModule(m) {
      return isAuth() && (
        isSuperAdmin() ||
        (request.auth.token.perms is list && m in request.auth.token.perms)
      );
    }

    // ── Staff ───────────────────────────────────────────────────────────────
    // The directory is readable by everyone signed in (crew pickers need it);
    // every write goes through saveStaffFn so seniority rules apply.
    match /staff/{staffId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // PIN hashes, lockout state and the username index never reach a browser.
    match /staffCredentials/{staffId} { allow read, write: if false; }
    match /usernames/{key}            { allow read, write: if false; }

    // ── Settings ────────────────────────────────────────────────────────────
    // One document, read by every screen. Only someone holding the settings
    // module, at Manager level or above, may change it.
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if docId == "general"
        && hasModule("settings")
        && isManagerOrAbove()
        && request.resource.data.pricing is map
        && request.resource.data.pricing.sumpRatePerCubicFt is number
        && request.resource.data.locations is list
        && request.resource.data.terms is list;
    }

    // ── Jobs (leads are jobs that are still "new" or "quoted") ──────────────
    function canSeeJobs() {
      return hasModule("leads") || hasModule("jobs") || hasModule("schedule")
        || hasModule("customers") || hasModule("billing") || hasModule("reports");
    }
    function canEditJobs() { return hasModule("leads") || hasModule("jobs"); }
    function isFieldRole() { return isAuth() && role() in ["Technician", "Supervisor"]; }

    // Mirrors JOB_TRANSITIONS in src/lib/job.ts; keep the two in step.
    function legalJobTransitions() {
      return {
        "new":         ["quoted", "scheduled", "cancelled"],
        "quoted":      ["new", "scheduled", "cancelled"],
        "scheduled":   ["quoted", "in_progress", "completed", "cancelled"],
        "in_progress": ["scheduled", "completed", "cancelled"],
        "completed":   ["in_progress"],
        "cancelled":   ["new"]
      };
    }

    function validJob(d) {
      return d.status in ["new", "quoted", "scheduled", "in_progress", "completed", "cancelled"]
        && d.customerName is string && d.customerName.size() > 0
        && d.tanks is list && d.sumps is list && d.addOns is list
        && d.subtotal is number && d.total is number && d.total >= 0 && d.total <= d.subtotal
        && d.isDeleted is bool;
    }

    match /jobs/{jobId} {
      allow read: if canSeeJobs();
      allow create: if canEditJobs()
        && validJob(request.resource.data)
        && request.resource.data.id == jobId
        && request.resource.data.createdBy == uid()
        && request.resource.data.isDeleted == false;
      allow update: if canEditJobs()
        && validJob(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status in legalJobTransitions()[resource.data.status])
        // Field crews move jobs along and add notes; the office edits the rest.
        && (!isFieldRole() || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "updatedBy", "startedAt", "completedAt", "notes",
                        "paidAmount", "paymentStatus"]));
      // Permanent deletion only from the trash.
      allow delete: if isManagerOrAbove() && canEditJobs() && resource.data.isDeleted == true;
    }

    // ── Payments ────────────────────────────────────────────────────────────
    // Crews collect cash on site, so anyone who can work on jobs may record a
    // payment in their own name. Payments are never edited or deleted; a
    // mistake is voided with a reason by someone with the billing module.
    match /payments/{paymentId} {
      allow read: if hasModule("billing") || hasModule("reports") || canEditJobs();
      allow create: if (hasModule("billing") || canEditJobs())
        && request.resource.data.id == paymentId
        && request.resource.data.createdBy == uid()
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.method in ["cash", "bank", "cheque", "card"]
        && request.resource.data.date is string
        && request.resource.data.jobId is string
        && request.resource.data.voided == false;
      allow update: if hasModule("billing")
        && resource.data.voided == false
        && request.resource.data.voided == true
        && request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["voided", "voidReason", "voidedAt"]);
      allow delete: if false;
    }

    // Quote and invoice numbers only ever move forward.
    match /counters/{name} {
      allow read: if isAuth();
      allow write: if name == "documents"
        && (hasModule("billing") || canEditJobs())
        && request.resource.data.quote is int && request.resource.data.invoice is int
        && (resource == null || (request.resource.data.quote >= resource.data.quote
                                 && request.resource.data.invoice >= resource.data.invoice));
    }

    // ── Inspections ─────────────────────────────────────────────────────────
    // Supervisors run them in the field, so anyone with the module may edit
    // the checklist; only Manager+ may delete one.
    function validInspection(d) {
      return d.type in ["tank", "sump", "cleaning"]
        && d.status in ["scheduled", "completed", "cancelled"]
        && d.customerName is string && d.customerName.size() > 0
        && d.findings is map && d.tanks is list && d.sumps is list;
    }

    match /inspections/{inspectionId} {
      allow read: if hasModule("inspections") || canEditJobs();
      allow create: if (hasModule("inspections") || canEditJobs())
        && validInspection(request.resource.data)
        && request.resource.data.id == inspectionId
        && request.resource.data.createdBy == uid();
      allow update: if (hasModule("inspections") || canEditJobs())
        && validInspection(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isManagerOrAbove() && hasModule("inspections");
    }

    // ── Customers ───────────────────────────────────────────────────────────
    function canSeeCustomers() {
      return hasModule("customers") || hasModule("leads") || hasModule("jobs") || hasModule("billing");
    }
    function validCustomer(d) {
      return d.name is string && d.name.size() > 0
        && d.phoneKey is string && d.sites is list && d.isDeleted is bool;
    }

    match /customers/{customerId} {
      allow read: if canSeeCustomers();
      allow create, update: if (hasModule("customers") || canEditJobs())
        && validCustomer(request.resource.data);
      allow delete: if isManagerOrAbove() && hasModule("customers");
    }

    // ── Audit log ───────────────────────────────────────────────────────────
    // Append-only. A client may add an entry only in its own name.
    match /auditLog/{entryId} {
      allow read: if isManagerOrAbove();
      allow create: if isAuth()
        && request.resource.data.actorId == uid()
        && request.resource.data.at is string
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // ── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
